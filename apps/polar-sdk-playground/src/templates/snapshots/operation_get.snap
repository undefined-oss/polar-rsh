///Get a customer by external ID.
///
///Required scopes: `customers:read`.
pub struct GetCustomer<'a, ClientService> {
    pub(super) client: &'a PolarClient<ClientService>,
    pub(super) organization_id: crate::models::common::OrganizationId,
    pub(super) external_id: String,
    pub(super) params: Option<GetCustomerParams>,
    pub(super) options: RequestOptions,
}

impl<'a, ClientService> GetCustomer<'a, ClientService> {
    pub(crate) fn build_request(
        &self,
    ) -> Result<http::Request<RequestBody>, BuildRequestError> {
        let encoded_external_id = crate::path::encode_segment(&self.external_id);
        let query_params = self
            .params
            .as_ref()
            .map_or_else(String::new, crate::query::EncodeQuery::encode_query);
        let mut path = format!(
            "v1/organizations/{}/customers/external/{}", self.organization_id,
            encoded_external_id
        );
        if !query_params.is_empty() {
            path.push_str(format!("?{query_params}").as_ref());
        }
        self.client.build_request(http::Method::GET, &path, None, &self.options)
    }
    pub fn options(mut self, options: RequestOptions) -> Self {
        self.options = options;
        self
    }
    pub fn params(mut self, params: GetCustomerParams) -> Self {
        self.params = Some(params);
        self
    }
}

