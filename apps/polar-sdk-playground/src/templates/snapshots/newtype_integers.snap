#[serde(transparent)]
pub struct Quantity(u64);

#[derive(Debug, Clone, PartialEq, Eq, thiserror::Error)]
pub enum QuantityValidationError {
    #[error("must be at least 1")]
    BelowMinimum,
}

impl Quantity {
    /// Validate a value.
    pub fn try_new(value: u64) -> Result<Self, QuantityValidationError> {
        Self::try_from(value)
    }
    /// Take the underlying value.
    pub fn into_inner(self) -> u64 {
        self.0
    }
}

impl TryFrom<u64> for Quantity {
    type Error = QuantityValidationError;
    fn try_from(value: u64) -> Result<Self, Self::Error> {
        if i128::from(value) < 1i128 {
            return Err(QuantityValidationError::BelowMinimum);
        }
        Ok(Self(value))
    }
}

impl From<Quantity> for u64 {
    fn from(value: Quantity) -> Self {
        value.0
    }
}

impl<'de> serde::Deserialize<'de> for Quantity {
    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>
    where
        D: serde::Deserializer<'de>,
    {
        let value = <u64 as serde::Deserialize>::deserialize(deserializer)?;
        Self::try_from(value).map_err(serde::de::Error::custom)
    }
}
