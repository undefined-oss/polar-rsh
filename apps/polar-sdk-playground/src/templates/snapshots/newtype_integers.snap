#[derive(
    Debug,
    Clone,
    PartialEq,
    PartialOrd,
    Copy,
    Eq,
    Ord,
    Hash,
    serde::Serialize,
    derive_more::Display,
    derive_more::Deref
)]
#[serde(transparent)]
pub struct Adjustment(i64);

#[derive(Debug, Clone, PartialEq, Eq, thiserror::Error)]
pub enum AdjustmentValidationError {
    #[error("must be at least -100")]
    BelowMinimum,
    #[error("must be at most 100")]
    AboveMaximum,
}

impl Adjustment {
    /// Validate a value.
    pub fn try_new(value: i64) -> Result<Self, AdjustmentValidationError> {
        Self::try_from(value)
    }
    /// Take the underlying value.
    pub fn into_inner(self) -> i64 {
        self.0
    }
}

impl TryFrom<i64> for Adjustment {
    type Error = AdjustmentValidationError;
    fn try_from(value: i64) -> Result<Self, Self::Error> {
        if i128::from(value) < -100i128 {
            return Err(AdjustmentValidationError::BelowMinimum);
        }
        if i128::from(value) > 100i128 {
            return Err(AdjustmentValidationError::AboveMaximum);
        }
        Ok(Self(value))
    }
}

impl From<Adjustment> for i64 {
    fn from(value: Adjustment) -> Self {
        value.0
    }
}

impl<'de> serde::Deserialize<'de> for Adjustment {
    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>
    where
        D: serde::Deserializer<'de>,
    {
        let value = <i64 as serde::Deserialize>::deserialize(deserializer)?;
        Self::try_from(value).map_err(serde::de::Error::custom)
    }
}

