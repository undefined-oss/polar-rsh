#[derive(Debug, Clone, serde::Serialize)]
#[serde(untagged)]
pub enum TextOrInteger {
    ///A textual value.
    Text(String),
    Integer(i64),
}

impl<'de> serde::Deserialize<'de> for TextOrInteger {
    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>
    where
        D: serde::Deserializer<'de>,
    {
        let value = <serde_json::Value as serde::Deserialize>::deserialize(
            deserializer,
        )?;
        let mut matched = None;
        if let Ok(payload) = serde_json::from_value::<String>(value.clone()) {
            if matched.is_some() {
                return Err(
                    serde::de::Error::custom(
                        concat!("ambiguous oneOf value for ", "TextOrInteger"),
                    ),
                );
            }
            matched = Some(Self::Text(payload));
        }
        if let Ok(payload) = serde_json::from_value::<i64>(value.clone()) {
            if matched.is_some() {
                return Err(
                    serde::de::Error::custom(
                        concat!("ambiguous oneOf value for ", "TextOrInteger"),
                    ),
                );
            }
            matched = Some(Self::Integer(payload));
        }
        matched
            .ok_or_else(|| serde::de::Error::custom(
                concat!("no matching oneOf variant for ", "TextOrInteger"),
            ))
    }
}
