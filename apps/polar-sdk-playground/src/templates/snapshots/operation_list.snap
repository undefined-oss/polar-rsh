#[derive(Debug, Clone, Default)]
pub struct ListCustomersParams {
    pub page: Option<std::num::NonZeroU64>,
    pub limit: Option<crate::models::pagination::PageLimit>,
    pub emails: Vec<String>,
    #[deprecated]
    pub active: Option<bool>,
    pub metadata: std::collections::BTreeMap<
        String,
        crate::models::common::unions::MetadataValue,
    >,
    ///Sort customers by one or more fields.
    pub sorting: Vec<
        (crate::models::customers::enums::CustomerSortField, crate::query::Sorting),
    >,
}

impl crate::query::EncodeQuery for ListCustomersParams {
    fn scalar_params(&self) -> Vec<(&'static str, String)> {
        let mut params = Vec::new();
        if let Some(value) = &self.page {
            params.push(("page", value.to_string()));
        }
        if let Some(value) = &self.limit {
            params.push(("limit", value.to_string()));
        }
        for value in &self.emails {
            params.push(("email", value.to_string()));
        }
        if let Some(value) = &self.active {
            params.push(("active", value.to_string()));
        }
        params
    }
    fn sorting_values(&self) -> Vec<String> {
        self.sorting
            .iter()
            .map(|(field, direction)| direction.encode(field.as_str()))
            .collect()
    }
    fn metadata_params(&self) -> Vec<(String, Vec<String>)> {
        self.metadata
            .iter()
            .map(|(key, value)| {
                let values = match value {
                    crate::models::common::unions::MetadataValue::String(values) => {
                        vec![values.to_string()]
                    }
                    crate::models::common::unions::MetadataValue::Strings(values) => {
                        values.iter().map(ToString::to_string).collect()
                    }
                };
                (key.clone(), values)
            })
            .collect()
    }
}

