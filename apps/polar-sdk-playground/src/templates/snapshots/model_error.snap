pub struct NotFound {
    pub error: monostate::MustBe!("not_found"),
    pub detail: String,
}

impl NotFound {
    pub fn new(required: NotFoundRequired) -> Self {
        Self {
            error: Default::default(),
            detail: required.detail,
        }
    }
}
