pub struct Checkouts<'a, ClientService> {
    client: &'a crate::client::PolarClient<ClientService>,
}

impl<'a, ClientService> Checkouts<'a, ClientService> {
    pub(crate) fn new(client: &'a crate::client::PolarClient<ClientService>) -> Self {
        Self { client }
    }
    pub fn confirm(
        &self,
        checkout_id: crate::models::common::CheckoutId,
        params: crate::models::checkouts::ConfirmCheckoutParams,
    ) -> crate::models::checkouts::ConfirmCheckout<'a, ClientService> {
        crate::models::checkouts::ConfirmCheckout {
            client: self.client,
            options: crate::client::RequestOptions::default(),
            payload: None,
            id: checkout_id,
            params: params,
        }
    }
}
