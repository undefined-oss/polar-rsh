}

impl<'a, ClientService> SaveCustomer<'a, ClientService> {
    pub(crate) fn build_request(
        &self,
    ) -> Result<http::Request<RequestBody>, BuildRequestError> {
        let path = format!("v1/customers",);
        let body = serde_json::to_vec(&self.payload)?;
        self.client
            .build_request(http::Method::POST, &path, Some(body.into()), &self.options)
    }
    pub fn options(mut self, options: RequestOptions) -> Self {
        self.options = options;
        self
    }
}

impl<'a, ClientService, Body> SaveCustomer<'a, ClientService>
where
    ClientService: tower::Service<
            http::Request<RequestBody>,
            Response = http::Response<Body>,
        > + Clone,
    Body: http_body::Body<Data = bytes::Bytes>,
    Body::Error: Into<tower::BoxError>,
{
    async fn execute(
        self,
    ) -> Result<
        crate::models::customers::types::Customer,
        SaveCustomerError<ClientService::Error>,
    > {
        let request = self
            .build_request()
            .map_err(|error| SaveCustomerError::from_failure(
                RequestFailure::BuildRequest(error),
            ))?;
        let response = self
            .client
            .send(request)
            .await
            .map_err(SaveCustomerError::Transport)?;
        let result: eros::Result<_, SaveCustomerErrors> = async {
            let response_code = response.status();
            let body_slice = response
                .into_body()
                .collect()
                .await
                .map_err(|error| eros::ErrorUnion::new(
                    RequestFailure::ReadBody(error.into()),
                ))?
                .to_bytes();
            match response_code {
                http::StatusCode::CREATED => {
                    serde_json::from_slice::<
                        crate::models::customers::types::Customer,
                    >(&body_slice)
                        .map_err(|error| eros::ErrorUnion::new(
                            RequestFailure::DecodeResponse(error),
                        ))
                }
                _ => {
                    Err(
                        eros::ErrorUnion::new(RequestFailure::UnexpectedStatus {
                            status: response_code,
                            body: body_slice,
                        }),
                    )
                }
            }
        }
            .await;
        result.map_err(Into::into)
    }
    pub async fn send(
        self,
    ) -> Result<
        crate::models::customers::types::Customer,
        SaveCustomerError<ClientService::Error>,
    > {
        let duration = self
            .options
            .timeout
            .unwrap_or_else(|| self.client.default_timeout());
        tokio::time::timeout(duration, self.execute())
            .await
            .map_err(|error| SaveCustomerError::from_failure(
                RequestFailure::Timeout(error),
            ))?
    }
}

impl<'a, ClientService, Body> std::future::IntoFuture for SaveCustomer<'a, ClientService>
where
    ClientService: tower::Service<
            http::Request<RequestBody>,
            Response = http::Response<Body>,
        > + Clone + 'a,
    ClientService::Future: 'a,
