use http_body_util::BodyExt;
use crate::client::{PolarClient, RequestBody, RequestOptions};
use crate::error::{BuildRequestError, RequestFailure};

#[derive(Debug, Clone)]
pub struct AuthorizeParams {
    ///The OAuth client identifier.
    pub client_id: String,
    pub redirect: Option<url::Url>,
    pub state: Option<String>,
}

#[derive(Debug, Clone)]
pub struct AuthorizeParamsRequired {
    ///The OAuth client identifier.
    pub client_id: String,
}

impl AuthorizeParams {
    pub fn new(required: AuthorizeParamsRequired) -> Self {
        Self {
            client_id: required.client_id,
            redirect: Default::default(),
            state: Default::default(),
        }
    }
}

impl crate::query::EncodeQuery for AuthorizeParams {
    fn scalar_params(&self) -> Vec<(&'static str, String)> {
        let mut params = Vec::new();
        params.push(("client_id", self.client_id.to_string()));
        if let Some(value) = &self.redirect {
            params.push(("redirect_uri", value.to_string()));
        }
        if let Some(value) = &self.state {
            params.push(("state", value.to_string()));
        }
        params
    }
}

#[derive(Debug, thiserror::Error)]
pub enum AuthorizeError<TransportError> {
    #[error("HTTP transport failed: {0}")]
    Transport(#[source] TransportError),
    #[error("failed to build request: {0}")]
    BuildRequest(#[source] crate::error::BuildRequestError),
    #[error("failed to read response body: {0}")]
    ReadBody(#[source] tower::BoxError),
    #[error("failed to decode response: {0}")]
    DecodeResponse(#[source] serde_json::Error),
    /// A documented error status without a response schema.
    #[error("HTTP error status: {status}")]
    HttpStatus { status: http::StatusCode, body: bytes::Bytes },
    #[error("unexpected HTTP status: {status}")]
    UnexpectedStatus { status: http::StatusCode, body: bytes::Bytes },
    #[error("request timed out")]
    Timeout(#[source] tokio::time::error::Elapsed),
}

pub(super) type AuthorizeErrors = (crate::error::RequestFailure,);

impl<T> From<eros::ErrorUnion<AuthorizeErrors>> for AuthorizeError<T> {
    fn from(error: eros::ErrorUnion<AuthorizeErrors>) -> Self {
        match error.into_enum() {
            eros::E1::A(error) => {
                match error {
                    crate::error::RequestFailure::BuildRequest(error) => {
                        Self::BuildRequest(error)
                    }
                    crate::error::RequestFailure::ReadBody(error) => {
                        Self::ReadBody(error)
                    }
                    crate::error::RequestFailure::DecodeResponse(error) => {
                        Self::DecodeResponse(error)
                    }
                    crate::error::RequestFailure::HttpStatus { status, body } => {
                        Self::HttpStatus { status, body }
                    }
                    crate::error::RequestFailure::UnexpectedStatus { status, body } => {
                        Self::UnexpectedStatus {
                            status,
                            body,
                        }
                    }
                    crate::error::RequestFailure::Timeout(error) => Self::Timeout(error),
                }
            }
        }
    }
}

impl<T> AuthorizeError<T> {
    pub(super) fn from_failure(error: crate::error::RequestFailure) -> Self {
        let union: eros::ErrorUnion<AuthorizeErrors> = eros::ErrorUnion::new(error);
        union.into()
    }
}

pub struct Authorize<'a, ClientService> {
    pub(super) client: &'a PolarClient<ClientService>,
    pub(super) params: AuthorizeParams,
    pub(super) options: RequestOptions,
}

impl<'a, ClientService> Authorize<'a, ClientService> {
    pub(crate) fn build_request(
        &self,
    ) -> Result<http::Request<RequestBody>, BuildRequestError> {
        let query_params = crate::query::EncodeQuery::encode_query(&self.params);
        let mut path = format!("v1/oauth2/authorize",);
        if !query_params.is_empty() {
            path.push_str(format!("?{query_params}").as_ref());
        }
        self.client.build_request(http::Method::GET, &path, None, &self.options)
    }
    pub fn options(mut self, options: RequestOptions) -> Self {
        self.options = options;
        self
    }
    pub fn params(mut self, params: AuthorizeParams) -> Self {
        self.params = params;
        self
    }
}

impl<'a, ClientService, Body> Authorize<'a, ClientService>
where
    ClientService: tower::Service<
            http::Request<RequestBody>,
            Response = http::Response<Body>,
        > + Clone,
    Body: http_body::Body<Data = bytes::Bytes>,
    Body::Error: Into<tower::BoxError>,
{
    async fn execute(
        self,
    ) -> Result<serde_json::Value, AuthorizeError<ClientService::Error>> {
        let request = self
            .build_request()
            .map_err(|error| AuthorizeError::from_failure(
                RequestFailure::BuildRequest(error),
            ))?;
        let response = self
            .client
            .send(request)
            .await
            .map_err(AuthorizeError::Transport)?;
        let result: eros::Result<_, AuthorizeErrors> = async {
            let response_code = response.status();
            let body_slice = response
                .into_body()
                .collect()
                .await
                .map_err(|error| eros::ErrorUnion::new(
                    RequestFailure::ReadBody(error.into()),
                ))?
                .to_bytes();
            match response_code {
                http::StatusCode::OK => {
                    serde_json::from_slice::<serde_json::Value>(&body_slice)
                        .map_err(|error| eros::ErrorUnion::new(
                            RequestFailure::DecodeResponse(error),
                        ))
                }
                _ => {
                    Err(
                        eros::ErrorUnion::new(RequestFailure::UnexpectedStatus {
                            status: response_code,
                            body: body_slice,
                        }),
                    )
                }
            }
        }
            .await;
        result.map_err(Into::into)
    }
    pub async fn send(
        self,
    ) -> Result<serde_json::Value, AuthorizeError<ClientService::Error>> {
        let duration = self
            .options
            .timeout
            .unwrap_or_else(|| self.client.default_timeout());
        tokio::time::timeout(duration, self.execute())
            .await
            .map_err(|error| AuthorizeError::from_failure(
                RequestFailure::Timeout(error),
            ))?
    }
}

impl<'a, ClientService, Body> std::future::IntoFuture for Authorize<'a, ClientService>
where
    ClientService: tower::Service<
            http::Request<RequestBody>,
            Response = http::Response<Body>,
        > + Clone + 'a,
    ClientService::Future: 'a,
    ClientService::Error: 'a,
    Body: http_body::Body<Data = bytes::Bytes> + 'a,
    Body::Error: Into<tower::BoxError>,
{
    type Output = Result<serde_json::Value, AuthorizeError<ClientService::Error>>;
    type IntoFuture = std::pin::Pin<
        Box<dyn std::future::Future<Output = Self::Output> + 'a>,
    >;
    fn into_future(self) -> Self::IntoFuture {
        Box::pin(self.send())
    }
}
